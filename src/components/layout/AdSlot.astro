---
/**
 * A reserved ad space. The box always keeps its height, so an ad loading
 * (or not loading) never pushes content around: this protects Core Web
 * Vitals (CLS), which Google uses for ranking.
 *
 * Before AdSense is set up (no PUBLIC_ADSENSE_CLIENT or no unit ID for the
 * placement) it shows a light "Advertisement" placeholder. Placements
 * switched off in AD_PLACEMENTS_OFF render nothing.
 */
import { ADSENSE_CLIENT, AD_PLACEMENTS_OFF, AD_SLOTS, type AdPlacement } from '@/config/site';

interface Props {
  placement: AdPlacement;
  /** Reserved height in px. Match it to the ad size served here. */
  height?: number;
  class?: string;
}
const { placement, height = 250, class: className = '' } = Astro.props;
const off = AD_PLACEMENTS_OFF.includes(placement);
const slot = AD_SLOTS[placement];
const live = Boolean(ADSENSE_CLIENT && slot);
---

{
  !off && (
    <aside class:list={['ad-slot flex items-center justify-center overflow-hidden print:hidden', className]} style={`min-height:${height}px`} aria-label="Advertisement" data-ad={placement}>
      {live ? (
        <ins class="adsbygoogle block w-full" style={`min-height:${height}px`} data-ad-client={ADSENSE_CLIENT} data-ad-slot={slot} data-ad-format="auto" data-full-width-responsive="true" />
      ) : (
        <div class="grid h-full w-full place-items-center rounded-xl border border-dashed border-line bg-surface/60 text-[11px] tracking-[0.18em] text-muted uppercase" style={`min-height:${height}px`}>
          Advertisement
        </div>
      )}
    </aside>
  )
}

{!off && live && <script is:inline>(window.adsbygoogle = window.adsbygoogle || []).push({});</script>}
