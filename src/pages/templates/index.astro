---
import BaseLayout from '@/layouts/BaseLayout.astro';
import AdSlot from '@/components/layout/AdSlot.astro';
import PreviewScale from '@/components/site/PreviewScale.astro';
import { PagePreview } from '@/components/site/PagePreview';
import { SITE } from '@/config/site';
import { previewResume, templatesByCategory } from '@/lib/site/catalog';
import { TEMPLATES } from '@/templates';

const groups = templatesByCategory();
const title = `${TEMPLATES.length} free resume templates for every field`;
const description = `Browse ${TEMPLATES.length} modern, ATS-friendly resume templates for software, engineering, healthcare, logistics, design, finance and academia. Free PDF download, no sign-up.`;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: title,
    description,
    url: new URL('/templates', Astro.site).href,
    isPartOf: { '@type': 'WebSite', name: SITE.name, url: Astro.site?.href },
    hasPart: TEMPLATES.map((t) => ({ '@type': 'CreativeWork', name: `${t.name} resume template`, url: new URL(`/templates/${t.id}`, Astro.site).href })),
  },
];
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <section class="container-page pt-12 pb-6 sm:pt-16">
    <p class="text-sm font-semibold text-brand">Free · ATS-friendly · A4 and US Letter</p>
    <h1 class="mt-2 max-w-3xl text-3xl font-bold tracking-tight text-balance sm:text-5xl">{title}</h1>
    <p class="mt-4 max-w-2xl text-lg text-muted">
      Each design is built for how recruiters in that field read a resume. Pick one to start; you can switch at any time and your content moves with you.
    </p>
    <nav aria-label="Fields" class="mt-6 flex flex-wrap gap-2">
      {
        groups.map((g) => (
          <a href={`#${g.slug}`} class="rounded-full border border-line bg-surface px-3 py-1.5 text-sm hover:border-brand/40">
            {g.category}
          </a>
        ))
      }
    </nav>
  </section>

  {
    groups.map((g, i) => (
      <>
      {i > 0 && i % 2 === 0 && <AdSlot placement="templates" height={100} class="mx-auto mt-10 w-[calc(100%-2rem)] max-w-[760px]" />}
      <section id={g.slug} class="container-page scroll-mt-24 pt-10">
        <h2 class="text-xl font-bold tracking-tight">{g.category}</h2>
        <ul class="mt-4 grid grid-cols-2 gap-5 sm:grid-cols-3 lg:grid-cols-4">
          {g.templates.map((t) => (
            <li class="card overflow-hidden">
              {/* The preview holds links of its own, so the card link sits on top of it rather than around it. */}
              <div class="relative border-b border-line bg-surface-2 p-3">
                <div class="overflow-hidden rounded shadow-sm ring-1 ring-line">
                  <PagePreview resume={previewResume(t)} template={t} zoom={0.3} />
                </div>
                <a href={`/templates/${t.id}`} class="absolute inset-0" aria-label={`${t.name} template preview`} />
              </div>
              <div class="p-3">
                <h3 class="text-sm font-semibold">
                  <a href={`/templates/${t.id}`} class="hover:text-brand">
                    {t.number}. {t.name}
                  </a>
                </h3>
                <p class="mt-1 line-clamp-2 text-xs text-muted">{t.description}</p>
                <a href={`/builder?template=${t.id}`} class="mt-3 inline-flex h-8 items-center rounded-lg bg-brand px-3 text-xs font-semibold text-brand-fg hover:opacity-90">
                  Use this template
                </a>
              </div>
            </li>
          ))}
        </ul>
      </section>
      </>
    ))
  }
  <AdSlot placement="templates" height={100} class="mx-auto mt-12 w-[calc(100%-2rem)] max-w-[760px]" />
  <PreviewScale />
</BaseLayout>
