---
import BaseLayout from '@/layouts/BaseLayout.astro';
import AdSlot from '@/components/layout/AdSlot.astro';
import Icon from '@/components/ui/Icon.astro';
import PreviewScale from '@/components/site/PreviewScale.astro';
import { PagePreview } from '@/components/site/PagePreview';
import { exampleIdFor, previewResume, slugify, templateFacts } from '@/lib/site/catalog';
import { sampleById } from '@/lib/resume/samples';
import { TEMPLATES } from '@/templates';
import type { TemplateDef } from '@/templates/types';

export function getStaticPaths() {
  return TEMPLATES.map((t) => ({ params: { id: t.id }, props: { t } }));
}

const { t } = Astro.props as { t: TemplateDef };
const exampleId = exampleIdFor(t);
const example = sampleById(exampleId)!;
const related = TEMPLATES.filter((x) => x.id !== t.id && x.category === t.category).concat(TEMPLATES.filter((x) => x.category !== t.category)).slice(0, 4);
const title = `${t.name} resume template`;
const description = `${t.description} Free ${t.name} resume template for ${t.category.toLowerCase()}: edit online, then download a PDF in A4 or US Letter.`;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Templates', item: new URL('/templates', Astro.site).href },
      { '@type': 'ListItem', position: 2, name: t.name, item: new URL(`/templates/${t.id}`, Astro.site).href },
    ],
  },
];
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <div class="container-page pt-8">
    <nav aria-label="Breadcrumb" class="text-sm text-muted">
      <a href="/templates" class="hover:text-fg">Templates</a>
      <span aria-hidden="true"> / </span>
      <a href={`/templates#${slugify(t.category)}`} class="hover:text-fg">{t.category}</a>
    </nav>
  </div>
  <section class="container-page grid gap-10 pt-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,34rem)]">
    <div>
      <p class="text-sm font-semibold text-brand">Template {t.number} of {TEMPLATES.length}</p>
      <h1 class="mt-2 text-3xl font-bold tracking-tight sm:text-4xl">{t.name}</h1>
      <p class="mt-4 text-lg text-muted">{t.description}</p>
      <p class="mt-2 text-sm text-muted">Made for: {t.category}</p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href={`/builder?template=${t.id}`} class="inline-flex h-11 items-center rounded-xl bg-brand px-5 font-semibold text-brand-fg hover:opacity-90">Use this template</a>
        <a href={`/builder?sample=${exampleId}&template=${t.id}`} class="inline-flex h-11 items-center rounded-xl border border-line bg-surface px-5 font-semibold hover:border-brand/40">
          Start from the {example.label.toLowerCase()} example
        </a>
      </div>
      <ul class="mt-8 space-y-3">
        {
          templateFacts(t).map((f) => (
            <li class="flex gap-3 text-sm">
              <Icon name="check" class="mt-0.5 size-4 shrink-0 text-accent" />
              {f}
            </li>
          ))
        }
      </ul>
      <p class="mt-8 text-sm text-muted">
        Already have a CV? <a href="/builder?import=1" class="font-medium text-brand hover:underline">Upload it</a> and it fills this template for you.
      </p>
    </div>
    <div class="rounded-2xl bg-surface-2 p-4 sm:p-6">
      <div class="overflow-hidden rounded shadow-lg ring-1 ring-line">
        <PagePreview resume={previewResume(t, exampleId)} template={t} zoom={0.62} />
      </div>
      <p class="mt-3 text-center text-xs text-muted">Shown with the {example.label.toLowerCase()} example. All names and details are made up.</p>
    </div>
  </section>

  <AdSlot placement="template" height={100} class="mx-auto mt-12 w-[calc(100%-2rem)] max-w-[760px]" />

  <section class="container-page pt-16">
    <h2 class="text-xl font-bold tracking-tight">More templates</h2>
    <ul class="mt-4 grid grid-cols-2 gap-5 sm:grid-cols-4">
      {
        related.map((r) => (
          <li class="group relative">
            <div class="overflow-hidden rounded shadow-sm ring-1 ring-line transition group-hover:ring-brand/50">
              <PagePreview resume={previewResume(r)} template={r} zoom={0.3} />
            </div>
            <p class="mt-2 text-sm font-semibold group-hover:text-brand">
              <a href={`/templates/${r.id}`} class="after:absolute after:inset-0">
                {r.name}
              </a>
            </p>
            <p class="text-xs text-muted">{r.category}</p>
          </li>
        ))
      }
    </ul>
  </section>
  <PreviewScale />
</BaseLayout>
