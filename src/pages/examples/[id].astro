---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/ui/Icon.astro';
import PreviewScale from '@/components/site/PreviewScale.astro';
import { PagePreview } from '@/components/site/PagePreview';
import { PHRASE_FIELDS } from '@/lib/resume/assist/phrases';
import { SAMPLES, type Sample } from '@/lib/resume/samples';
import { EXAMPLE_NOTES } from '@/lib/site/catalog';
import { getTemplate, TEMPLATES } from '@/templates';

export function getStaticPaths() {
  return SAMPLES.map((s) => ({ params: { id: s.id }, props: { sample: s } }));
}

const { sample } = Astro.props as { sample: Sample };
const r = sample.build();
const template = getTemplate(r.settings.template);
const notes = EXAMPLE_NOTES[sample.id];
const field = PHRASE_FIELDS.find((f) => f.id === notes.field);
const others = TEMPLATES.filter((t) => t.category === template.category && t.id !== template.id).slice(0, 3);
const description = `${notes.intro} See the full example, tips for your own ${sample.label.toLowerCase()} resume, and open it in the free builder.`;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Examples', item: new URL('/examples', Astro.site).href },
      { '@type': 'ListItem', position: 2, name: notes.title, item: new URL(`/examples/${sample.id}`, Astro.site).href },
    ],
  },
];
---

<BaseLayout title={notes.title} description={description} jsonLd={jsonLd}>
  <div class="container-page pt-8">
    <nav aria-label="Breadcrumb" class="text-sm text-muted">
      <a href="/examples" class="hover:text-fg">Examples</a>
      <span aria-hidden="true"> / </span>{sample.field}
    </nav>
  </div>
  <section class="container-page grid gap-10 pt-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,34rem)]">
    <div>
      <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">{notes.title}</h1>
      <p class="mt-4 text-lg text-muted">{notes.intro}</p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href={`/builder?sample=${sample.id}`} class="inline-flex h-11 items-center rounded-xl bg-brand px-5 font-semibold text-brand-fg hover:opacity-90">Edit this example</a>
        <a href="/builder?import=1" class="inline-flex h-11 items-center gap-2 rounded-xl border border-line bg-surface px-5 font-semibold hover:border-brand/40">
          <Icon name="upload" class="size-4" /> Use my own CV instead
        </a>
      </div>

      <h2 class="mt-10 text-xl font-bold tracking-tight">Tips for your {sample.label.toLowerCase()} resume</h2>
      <ul class="mt-4 space-y-3">
        {
          notes.tips.map((tip) => (
            <li class="flex gap-3">
              <Icon name="check" class="mt-1 size-4 shrink-0 text-accent" />
              <span>{tip}</span>
            </li>
          ))
        }
      </ul>

      {
        field && (
          <>
            <h2 class="mt-10 text-xl font-bold tracking-tight">Bullet points to adapt</h2>
            <p class="mt-2 text-sm text-muted">Replace the parts in [brackets] with your own facts. In the builder, the “Ideas” button offers these as you write.</p>
            <ul class="mt-4 list-disc space-y-1.5 pl-5">
              {field.bullets.slice(0, 6).map((b) => (
                <li>{b}</li>
              ))}
            </ul>
            <h3 class="mt-6 font-semibold">A summary to start from</h3>
            <p class="mt-2 rounded-xl border border-line bg-surface p-4 text-sm">{field.summaries[0]}</p>
          </>
        )
      }
    </div>
    <div>
      <div class="rounded-2xl bg-surface-2 p-4 sm:p-6">
        <div class="overflow-hidden rounded shadow-lg ring-1 ring-line">
          <PagePreview resume={r} template={template} zoom={0.62} />
        </div>
        <p class="mt-3 text-center text-xs text-muted">
          Shown in the <a class="text-brand hover:underline" href={`/templates/${template.id}`}>{template.name}</a> template. Names and details are made up.
        </p>
      </div>
      {
        others.length > 0 && (
          <p class="mt-4 text-sm text-muted">
            Also good for this field:{' '}
            {others.map((t, i) => (
              <>
                {i > 0 && ', '}
                <a class="text-brand hover:underline" href={`/templates/${t.id}`}>
                  {t.name}
                </a>
              </>
            ))}
          </p>
        )
      }
    </div>
  </section>
  <PreviewScale />
</BaseLayout>
