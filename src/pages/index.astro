---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/ui/Icon.astro';
import AdSlot from '@/components/layout/AdSlot.astro';
import PreviewScale from '@/components/site/PreviewScale.astro';
import { PagePreview } from '@/components/site/PagePreview';
import { SITE } from '@/config/site';
import { previewResume, templatesByCategory } from '@/lib/site/catalog';
import { getTemplate, TEMPLATES } from '@/templates';

const featured = ['code-block', 'credential-first', 'bento', 'executive-gold'].map(getTemplate);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: SITE.name,
    url: Astro.site?.href,
    description: SITE.description,
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    publisher: { '@type': 'Organization', name: SITE.name, logo: { '@type': 'ImageObject', url: new URL(SITE.logo, Astro.site).href } },
  },
];

const points = [
  { icon: 'layout', title: 'Modern templates', text: 'Designs made for your field, from software and engineering to healthcare, logistics and finance.' },
  { icon: 'file', title: 'A4, US Letter or Legal', text: 'See real pages as you type, with clean page breaks and space at the top of every new page.' },
  { icon: 'download', title: 'Free PDF download', text: 'Text stays selectable and readable by applicant tracking systems (ATS). No watermark.' },
  { icon: 'upload', title: 'Bring your old CV', text: 'Upload a PDF or Word CV and it fills the editor for you, ready for any template.' },
  { icon: 'lock', title: 'Private by design', text: 'No sign-up. Your resume and any file you import stay in your own browser.' },
];

const steps = [
  { n: '1', title: 'Pick a template', text: 'Choose a design for your profession. You can switch at any time without retyping.' },
  { n: '2', title: 'Add your details', text: 'Upload your current CV (PDF or Word) and we fill everything in, or start from an example. It all saves as you go.' },
  { n: '3', title: 'Download your PDF', text: 'Choose A4, US Letter or US Legal and save a print-ready PDF.' },
];
---

<BaseLayout title={`${SITE.name} – Free Resume Builder with Modern Templates`} description={SITE.description} jsonLd={jsonLd}>
  <section class="container-page pt-16 pb-12 text-center sm:pt-24">
    <p class="text-sm font-semibold text-brand">Free · No sign-up · No watermark</p>
    <h1 class="mx-auto mt-3 max-w-3xl text-4xl font-bold tracking-tight text-balance sm:text-6xl">Build a modern resume in minutes</h1>
    <p class="mx-auto mt-5 max-w-2xl text-lg text-muted text-pretty">
      Choose a template made for your field, fill in your details and download a print-ready PDF. Everything stays on your device.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/builder" class="inline-flex h-12 items-center rounded-xl bg-brand px-6 font-semibold text-brand-fg hover:opacity-90">Build my resume</a>
      <a href="/builder?import=1" class="inline-flex h-12 items-center gap-2 rounded-xl border border-brand/40 bg-brand-soft px-6 font-semibold hover:border-brand">
        <Icon name="upload" class="size-5" /> Upload my current CV
      </a>
      <a href="/templates" class="inline-flex h-12 items-center rounded-xl border border-line bg-surface px-6 font-semibold hover:border-brand/40">See templates</a>
    </div>
  </section>

  <section class="container-page grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
    {
      points.map((p) => (
        <div class="card p-5">
          <span class="grid size-10 place-items-center rounded-xl bg-brand-soft text-brand">
            <Icon name={p.icon} />
          </span>
          <h2 class="mt-4 font-semibold">{p.title}</h2>
          <p class="mt-1.5 text-sm text-muted">{p.text}</p>
        </div>
      ))
    }
  </section>

  <section id="templates" class="container-page scroll-mt-24 pt-20">
    <h2 class="text-2xl font-bold tracking-tight">{TEMPLATES.length} templates for every field</h2>
    <p class="mt-2 max-w-2xl text-muted">Each design is built for how recruiters in that field read a resume.</p>
    <ul class="mt-6 grid grid-cols-2 gap-5 lg:grid-cols-4">
      {
        featured.map((t) => (
          <li class="group relative">
            <div class="overflow-hidden rounded-lg shadow-sm ring-1 ring-line transition group-hover:ring-brand/50">
              <PagePreview resume={previewResume(t)} template={t} zoom={0.34} />
            </div>
            <p class="mt-2 text-sm font-semibold group-hover:text-brand">
              <a href={`/templates/${t.id}`} class="after:absolute after:inset-0">
                {t.name}
              </a>
            </p>
            <p class="text-xs text-muted">{t.category}</p>
          </li>
        ))
      }
    </ul>
    <ul class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {
        templatesByCategory().map((g) => (
          <li>
            <a href={`/templates#${g.slug}`} class="flex items-center gap-2 rounded-xl border border-line bg-surface px-4 py-3 text-sm font-medium hover:border-brand/40">
              <Icon name="check" class="size-4 text-accent" />
              {g.category}
              <span class="ml-auto text-xs text-muted">{g.templates.length}</span>
            </a>
          </li>
        ))
      }
    </ul>
    <p class="mt-6"><a href="/templates" class="font-semibold text-brand hover:underline">See all {TEMPLATES.length} templates →</a></p>
  </section>

  <AdSlot placement="home" height={100} class="mx-auto mt-12 w-[calc(100%-2rem)] max-w-[760px]" />

  <section id="how-it-works" class="container-page scroll-mt-24 pt-20">
    <h2 class="text-2xl font-bold tracking-tight">How it works</h2>
    <ol class="mt-6 grid gap-4 sm:grid-cols-3">
      {
        steps.map((s) => (
          <li class="card p-5">
            <span class="grid size-9 place-items-center rounded-full bg-brand text-sm font-bold text-brand-fg">{s.n}</span>
            <h3 class="mt-4 font-semibold">{s.title}</h3>
            <p class="mt-1.5 text-sm text-muted">{s.text}</p>
          </li>
        ))
      }
    </ol>
    <div class="mt-10 text-center">
      <a href="/builder" class="inline-flex h-12 items-center rounded-xl bg-brand px-6 font-semibold text-brand-fg hover:opacity-90">Start building, it's free</a>
    </div>
  </section>
  <PreviewScale />
</BaseLayout>
